# =============================================================================
# DSSYWLC website — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# Vars prefixed with NEXT_PUBLIC_ are exposed to the browser (not secret).
# =============================================================================

# --- Site -------------------------------------------------------------------
# Public base URL of the deployment. Used to build profile/email links.
# If unset, emails fall back to https://dssywlcnsut.in.
NEXT_PUBLIC_SITE_URL="https://dssywlcnsut.in"

# --- Database (Neon Postgres) ----------------------------------------------
# Connection string from the Neon dashboard (pooled connection recommended).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- S3 (uploads: payment screenshots + IEEE cards) ------------------------
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
# Optional: custom/non-AWS S3-compatible endpoint. Leave unset for AWS S3.
# S3_ENDPOINT=""

# --- Brevo (transactional email) -------------------------------------------
BREVO_API_KEY="xkeysib-..."
BREVO_FROM_EMAIL="no-reply@dssywlcnsut.in"
BREVO_FROM_NAME="DSSYWLC '25"

# --- Google Sheets (registration sync) -------------------------------------
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL="xxx@xxx.iam.gserviceaccount.com"
# Paste the full private key. Keep the literal \n sequences — the app converts
# them to real newlines at runtime.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Cloudflare Turnstile (CAPTCHA) ----------------------------------------
# Both must be set to enable CAPTCHA. In PRODUCTION the secret is REQUIRED:
# if it is missing, registration submissions are rejected (fail-closed).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Admin status-sync API -------------------------------------------------
# Shared secret the Google Apps Script sends in the x-admin-secret header to
# POST /api/admin/update-status. Use a long random string.
ADMIN_API_SECRET=""

# --- PostHog (analytics) ----------------------------------------------------
# Set BOTH or NEITHER. If the token is set but the host is not, analytics
# requests are blocked by the Content-Security-Policy.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Bank transfer details (shown on the payment step) ----------------------
# Public — rendered on /register. If unset, fields display as "—".
NEXT_PUBLIC_BENEFICIARY_NAME=""
NEXT_PUBLIC_BANK_NAME=""
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=""
NEXT_PUBLIC_BANK_IFSC_CODE=""
NEXT_PUBLIC_BANK_ACCOUNT_TYPE=""
